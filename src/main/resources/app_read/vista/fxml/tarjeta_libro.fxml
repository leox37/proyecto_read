            <Image url="@../assets/libro_default.png" />
         </image>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </ImageView>
      <Pane prefHeight="157.0" prefWidth="14.0" />
      <VBox prefHeight="141.0" prefWidth="393.0">
         <children>
            <Label fx:id="label_nombre_libro1" text="Nombre" textFill="WHITE" />
            <Label fx:id="label_autor" text="Autor" textFill="WHITE" />
            <Label fx:id="label_tipo1" text="Tipo" textFill="WHITE">
               <font>
                  <Font name="System Bold Italic" size="12.0" />
               </font></Label>
            <Pane prefHeight="23.0" prefWidth="309.0" />
            <HBox alignment="CENTER_LEFT" spacing="8.0">
