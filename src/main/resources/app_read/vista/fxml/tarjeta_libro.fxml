                        <Image url="@../assets/library.png" />
                     </image>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </ImageView>
                  <Pane prefHeight="29.0" prefWidth="45.0" />
                  <ImageView fx:id="boton_mas_tarjeta" fitHeight="26.0" fitWidth="56.0" pickOnBounds="true" preserveRatio="true">
