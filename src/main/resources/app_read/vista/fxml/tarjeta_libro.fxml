                        <Image url="@../assets/star.png" />
                     </image>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </ImageView>
                  <Pane prefHeight="29.0" prefWidth="45.0" />
                  <ImageView fx:id="boton_agregar_despues" fitHeight="26.0" fitWidth="51.0" pickOnBounds="true" preserveRatio="true">
